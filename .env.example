# Google Gemini API Key
GOOGLE_API_KEY=your-gemini-api-key

# Firebase Service Account — TWO OPTIONS (use one):
#
# Option 1: JSON string (for Vercel / cloud deployments)
# Paste the entire contents of your serviceAccountKey.json as a single line
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
#
# Option 2: File path (for local development)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Firebase Storage bucket name (e.g., your-project-id.appspot.com)
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com

# Firestore database ID (use "(default)" for default database, or your named database ID)
FIRESTORE_DATABASE_ID=(default)

# Server port (optional, defaults to 3000)
PORT=3000
